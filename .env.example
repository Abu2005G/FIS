# Copy to .env and fill in. Never commit .env.

# Required. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# development | production (production hides /docs and forbids the mock LLM)
ENVIRONMENT=development

# Any SQLAlchemy URL. SQLite suits one instance; use PostgreSQL beyond that.
DATABASE_URL=sqlite:///./fis.db

# none   = scorecard only, no model
# ollama = local model (statement text stays on your machine)
# openai = cloud model (statement text is sent to OpenAI; needs `pip install openai`)
# mock   = offline stand-in for development, not a model
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# OPENAI_API_KEY=

LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_MAX_TRANSACTIONS=150
LLM_BATCH_SIZE=25

MAX_UPLOAD_BYTES=10485760
# true: 03/04/2026 is 3 April. false: 4 March.
STATEMENT_DAY_FIRST=true
LOG_LEVEL=INFO
